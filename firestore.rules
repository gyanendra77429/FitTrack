rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        data.dailyStepGoal is int && data.dailyStepGoal >= 1000 && data.dailyStepGoal <= 100000 &&
        data.preferredUnit in ['km', 'mi'] &&
        (data.strideLengthMeters is number) && data.strideLengthMeters >= 0.3 && data.strideLengthMeters <= 2.5 &&
        (!('age' in data) || (data.age is int && data.age >= 1 && data.age <= 120)) &&
        (!('heightCm' in data) || (data.heightCm is number && data.heightCm >= 30.0 && data.heightCm <= 300.0)) &&
        (!('weightKg' in data) || (data.weightKg is number && data.weightKg >= 10.0 && data.weightKg <= 500.0)) &&
        (!('stepRemindersEnabled' in data) || (data.stepRemindersEnabled is bool)) &&
        (!('themePreference' in data) || (data.themePreference in ['system', 'light', 'dark'])) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyActivity(data) {
      return data.date is string && data.date.size() == 10 &&
        data.steps is int && data.steps >= 0 &&
        data.stepGoal is int && data.stepGoal >= 1 &&
        (data.distanceMeters is number) && data.distanceMeters >= 0 &&
        (data.calories is number) && data.calories >= 0 &&
        data.activeMinutes is int && data.activeMinutes >= 0 &&
        data.goalReached is bool &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWorkout(data, userId) {
      return data.id is string && data.id.size() >= 1 &&
        data.userId == userId &&
        data.type in ['walking', 'running', 'cycling', 'stretching'] &&
        data.durationSeconds is int && data.durationSeconds >= 0 &&
        data.steps is int && data.steps >= 0 &&
        (data.distanceMeters is number) && data.distanceMeters >= 0 &&
        (data.calories is number) && data.calories >= 0 &&
        (!('avgPaceSecondsPerKm' in data) || ((data.avgPaceSecondsPerKm is number) && data.avgPaceSecondsPerKm >= 0)) &&
        data.date is string && data.date.size() == 10 &&
        (!('timestamp' in data) || (data.timestamp is timestamp && data.timestamp <= request.time)) &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAchievement(data) {
      return data.id is string && data.id.size() >= 1 &&
        data.badgeId in ['first_activity', 'steps_5k', 'steps_10k', 'streak_7d', 'month_100k'] &&
        data.title is string && data.title.size() >= 1 &&
        data.description is string &&
        data.isUnlocked is bool &&
        data.unlockedAt is timestamp && data.unlockedAt <= request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /daily_activity/{dateId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDailyActivity(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /workouts/{workoutId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWorkout(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /achievements/{badgeId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAchievement(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
